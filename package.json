{
  "name": "audio-sample",
  "version": "7.0.0",
  "description": "A wrapper to turn webcam audio samples into buffers.",
  "type": "module",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "umd": "./dist/umd/index.js",
      "require": "./dist/cjs/index.cjs",
      "import": "./dist/esm/index.js"
    }
  },
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "types": "tsc --noEmit",
    "types:config": "tsc --showConfig",
    "lint": "eslint --color .",
    "lint:fix": "eslint --color --fix .",
    "build": "cross-env NODE_ENV=production rslib build",
    "test": "cross-env NODE_OPTIONS='--import=tsx' tape test/*.ts",
    "prettier": "prettier --check ./src ./test *.js .ts",
    "prettier:fix": "prettier --write ./src ./test *.js .ts"
  },
  "keywords": [
    "audio",
    "webcam",
    "float32array",
    "buffer"
  ],
  "author": {
    "name": "Michael Heuberger",
    "email": "michael.heuberger@binarykitchen.com"
  },
  "readmeFilename": "README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binarykitchen/audio-sample.git"
  },
  "homepage": "https://github.com/binarykitchen/audio-sample",
  "bugs": {
    "url": "https://github.com/binarykitchen/audio-sample/issues"
  },
  "engines": {
    "node": ">=26.5.0",
    "npm": ">=11.16.0"
  },
  "prettier": "./prettier.config.js",
  "dependencies": {
    "typedarray-to-buffer": "4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rsbuild/plugin-node-polyfill": "1.4.6",
    "@rsdoctor/rspack-plugin": "1.6.5",
    "@rslib/core": "1.0.3",
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@types/tape": "5.8.1",
    "@types/typedarray-to-buffer": "4.0.4",
    "cross-env": "10.1.0",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "tape": "5.10.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
